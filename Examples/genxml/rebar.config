
{erl_opts, [debug_info]}.

{deps, [gen_xml]}.

{dialyzer,
 [ {plt_extra_mods,
    [ gen_xml,
      gen_xml_cli,
      genxml_counts,
      genxml_null,
      genxml_paths
    ] }
 ] }.

{escript_incl_apps, [genxml, gen_xml]}.
{escript_main_app, genxml}.
{escript_name, genxml}.
{escript_emu_args, "%%! +sbtu +A1 -escript main genxml_cli\n"}.
